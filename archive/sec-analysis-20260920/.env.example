# Phase-1: Finnhub (US/HK quotes + news) + Tiingo (US daily OHLCV)
# + FMP (US statements) + AKShare (CN quotes / bars / news / 财报)
# + IBKR / Longbridge read-only. Copy to .env. Do not commit real secrets.

# --- Finnhub (US/HK quote + general + US company news) -------------------
FINNHUB_API_KEY=
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_ROUTE_US=finnhub
MARKET_DATA_ROUTE_HK=finnhub
MARKET_DATA_ROUTE_DEFAULT=finnhub
# China A-shares: AKShare East Money scrape (optional extra: uv sync --extra akshare)
MARKET_DATA_ROUTE_CN=akshare
MARKET_DATA_ROUTE_JP=stub
MARKET_DATA_ROUTE_KR=stub

# --- Tiingo (US historical daily OHLCV + volume; free/starter EOD) -------
# Missing key → ProviderConfigError. No invented bars. Not used for quotes.
TIINGO_API_KEY=
HISTORY_ROUTE_US=tiingo
HISTORY_ROUTE_DEFAULT=tiingo
HISTORY_ROUTE_HK=
HISTORY_ROUTE_CN=
HISTORY_ROUTE_JP=
HISTORY_ROUTE_KR=

NEWS_PROVIDER=finnhub
NEWS_ROUTE_US=finnhub
NEWS_ROUTE_HK=finnhub
NEWS_ROUTE_DEFAULT=finnhub
NEWS_ROUTE_CN=akshare
NEWS_ROUTE_JP=
NEWS_ROUTE_KR=

# --- IBKR read-only. Phase-1 recommended: Flex Web Service (no Gateway) ---
BROKER_CLIENT=ibkr
# auto (use Flex when token+query set) | flex | gateway
BROKER_IBKR_MODE=auto
IBKR_READONLY=true
# Client Portal: Settings → Reporting → Flex Web Service → generate token.
# Create an Activity Flex Query (Account Information, Open Positions, Trades, Cash Report).
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Optional second query if positions are a separate Flex Query:
# IBKR_FLEX_ACTIVITY_QUERY_ID=
# IBKR_FLEX_POSITION_QUERY_ID=
# Optional later Gateway / TWS (not required for Flex):
IBKR_HOST=127.0.0.1
IBKR_PORT=5000
IBKR_ACCOUNT_ID=
IBKR_CLIENT_ID=1
IBKR_GATEWAY_MODE=stub

# --- Longbridge read-only (HK account / positions / fills). No quotes. ---
# Default: token trio (LONGBRIDGE_AUTH=token or unset). Existing setups keep working.
LONGBRIDGE_MODE=stub
LONGBRIDGE_AUTH=token
LONGBRIDGE_ACCOUNT_ID=
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# Opt-in OAuth 2.0 (LONGBRIDGE_AUTH=oauth). Do NOT put OAuth access tokens here.
# Register (save client_id only; public client, no secret):
#   curl -X POST https://openapi.longbridge.com/oauth2/register \
#        -H "Content-Type: application/json" \
#        -d '{"redirect_uris":["http://localhost:60355/callback"],"token_endpoint_auth_method":"none","grant_types":["authorization_code","refresh_token"],"response_types":["code"],"client_name":"sec-analysis"}'
# Then: uv sync --extra longbridge && LONGBRIDGE_MODE=live && sec-analysis longbridge-login
# Token file: ~/.longbridge/openapi/tokens/<client_id>
# LONGBRIDGE_AUTH=oauth
LONGBRIDGE_CLIENT_ID=
# LONGPORT_APP_KEY=
# LONGPORT_APP_SECRET=
# LONGPORT_ACCESS_TOKEN=

# CN 财报 (Sina three statements via AKShare). US statements → FMP.
FMP_API_KEY=
FUNDAMENTALS_PROVIDER=fmp
FUNDAMENTALS_ROUTE_CN=akshare
FUNDAMENTALS_ROUTE_US=fmp
FUNDAMENTALS_ROUTE_DEFAULT=fmp

# --- Not phase-1 (stubs only) --------------------------------------------
OPTIONS_PROVIDER=stub
MASSIVE_API_KEY=
TWELVE_DATA_API_KEY=
EODHD_API_KEY=

CACHE_PATH=data/sec_analysis.sqlite
RATE_LIMIT_PER_MINUTE=50
HTTP_TIMEOUT=15.0
